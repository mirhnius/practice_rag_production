# Copy this file to .env and fill values in as you reach each week.
#
# This project has its own local infra (Postgres, OpenSearch, Ollama,
# Redis, Airflow, Langfuse) in compose.yml right here — no need to touch
# the course repo for everyday work. Start it with:
#
#   docker compose up -d
#
# then everything below already points at localhost with matching ports.

# --- Week 1: app settings ---
DEBUG=true
ENVIRONMENT=development

# --- Week 2: Postgres + arXiv ingestion ---
POSTGRES_DATABASE_URL=postgresql+psycopg2://rag_user:rag_password@localhost:5432/rag_db
ARXIV_BASE_URL=https://export.arxiv.org/api/query
ARXIV_SEARCH_CATEGORY=cs.AI
ARXIV_MAX_RESULTS=15
ARXIV_RATE_LIMIT_DELAY=3.0
ARXIV_PDF_CACHE_DIR=./data/arxiv_pdfs

# --- Week 3: OpenSearch / BM25 ---
OPENSEARCH_HOST=http://localhost:9200
OPENSEARCH_INDEX_NAME=arxiv-papers

# --- Week 4: chunking + embeddings ---
CHUNK_SIZE=600
CHUNK_OVERLAP_SIZE=100
CHUNK_MIN_SIZE=100
JINA_API_KEY=your_jina_api_key_here

# --- Week 5: local LLM ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# --- Week 6: caching + observability ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL_HOURS=24
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# Langfuse's own server config (for compose.yml's langfuse-web/-worker
# services — different from the four app-facing values above, which you
# fill in once you've logged into Langfuse and created a project).
# These are fine as-is for local dev; only ENCRYPTION_KEY actually needs
# to be a real value for Langfuse to start (already generated below).
LANGFUSE_NEXTAUTH_SECRET=changeme-v3-nextauth-secret-min-32-chars-recommended
LANGFUSE_SALT=changeme-v3-salt-min-32-chars-recommended-for-security
LANGFUSE_ENCRYPTION_KEY=278af1d9b4508fdb84dfd79d1f9f6661bccac3b5a3760403a23ac4dd8990296d
LANGFUSE_REDIS_PASSWORD=langfuse_redis_password
LANGFUSE_MINIO_ACCESS_KEY=langfuse_minio
LANGFUSE_MINIO_SECRET_KEY=langfuse_minio_secret

# --- Week 7: agentic RAG + Telegram bot ---
TELEGRAM_BOT_TOKEN=
